# Source Hub API URL including its prefix.
DRIVERSHUB_SOURCE_URL=https://hub.example.com/api

# Dedicated application token created for the migration.
DRIVERSHUB_APPLICATION_TOKEN=

# Local directory used for assessment and later export data.
DRIVERSHUB_MIGRATION_DIRECTORY=migrations/example

# Use aio for DriversHubDockerAIO or mariadb for direct database access.
DRIVERSHUB_TARGET_MODE=aio

# Initialized Drivers Hub Docker AIO directory. Used only in aio mode.
DRIVERSHUB_TARGET_DIRECTORY=/opt/DriversHubDockerAIO

# Destination database connection. Used only in mariadb mode.
DRIVERSHUB_TARGET_DB_HOST=127.0.0.1
DRIVERSHUB_TARGET_DB_PORT=3306
DRIVERSHUB_TARGET_DB_USER=drivershub
DRIVERSHUB_TARGET_DB_PASSWORD=
DRIVERSHUB_TARGET_DB_NAME=drivershub
DRIVERSHUB_TARGET_DB_UNIX_SOCKET=

# Backend config.json path for a non-AIO destination.
DRIVERSHUB_TARGET_CONFIG_PATH=

# Minimum delay between source requests in seconds.
DRIVERSHUB_REQUEST_INTERVAL=1.1

# Some GET endpoints update source-side administrator activity.
DRIVERSHUB_ALLOW_SOURCE_SIDE_EFFECTS=false

# Delivery detail requests increment each delivery's view counter. This is
# separate from ordinary source activity updates and is disabled by default.
DRIVERSHUB_ALLOW_DELIVERY_VIEW_UPDATES=false
